Процедура ПриИзмененииСтроки(Элемент)
    Если Элемент.Имя = "Товары" Тогда
        ТекущаяСтрока = Элемент.ТекущиеДанные;

        // Пересчет суммы строки
        Если ТекущаяСтрока.Количество <> Неопределено И ТекущаяСтрока.ЦенаЗакупки <> Неопределено Тогда
            ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаЗакупки;
        Иначе
            ТекущаяСтрока.Сумма = 0;
        КонецЕсли;

        // Пересчет общей суммы
        ЭтотОбъект.Сумма = 0;
        Для Каждого Строка Из Товары Цикл
            ЭтотОбъект.Сумма = ЭтотОбъект.Сумма + Строка.Сумма;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры  

Процедура ОбработкаПроведения(Отказ)
    Движения.ОстаткиТоваров.Записывать = Истина;

    Для Каждого Строка Из Товары Цикл
        // Добавляем движение прихода остатков
        Движение = Движения.ОстаткиТоваров.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
        Движение.Период = ЭтотОбъект.Дата;
        Движение.Номенклатура = Строка.Номенклатура;
        Движение.Склад = ЭтотОбъект.Склад;
        Движение.Количество = Строка.Количество;
    КонецЦикла;
КонецПроцедуры