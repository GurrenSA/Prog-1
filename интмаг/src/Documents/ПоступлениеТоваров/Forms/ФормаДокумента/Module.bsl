Процедура ТоварыПриИзменении(Элемент)
    // 1. Получаем текущую строку табличной части
    ТекущаяСтрока = Элемент.ТекущиеДанные;
    
    // 2. Пересчитываем сумму для текущей строки
    Если ТекущаяСтрока <> Неопределено Тогда
        Если ТекущаяСтрока.Количество <> Неопределено 
            И ТекущаяСтрока.ЦенаЗакупки <> Неопределено Тогда
            ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаЗакупки;
        Иначе
            ТекущаяСтрока.Сумма = 0;
        КонецЕсли;
    КонецЕсли;
    
    // 3. Пересчитываем общую сумму документа
    СуммаДокумента = 0;
    Для Каждого Строка Из Элемент.Данные Цикл  // Используем Элемент.Данные вместо глобального "Товары"
        Если Строка.Сумма <> Неопределено Тогда
            СуммаДокумента = СуммаДокумента + Строка.Сумма;
        КонецЕсли;
    КонецЦикла;
    
    // 4. Обновляем реквизит документа (не элемент формы!)
    Объект.Сумма = СуммаДокумента;
КонецПроцедуры