Процедура ТоварыНоменклатураПриИзменении(Элемент)
    // Получаем текущую строку через элементы формы
    ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
    
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если ТекущаяСтрока.Номенклатура <> Неопределено Тогда
        // Подстановка цены из номенклатуры
        ТекущаяСтрока.ЦенаПродажи = ТекущаяСтрока.Номенклатура.Цена;
        
        // Установка количества по умолчанию
        Если ТекущаяСтрока.Количество = Неопределено Или ТекущаяСтрока.Количество = 0 Тогда
            ТекущаяСтрока.Количество = 1;
        КонецЕсли;
        
        // Расчет суммы
        ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.ЦенаПродажи;
        
        // Обновление отображения
        Элементы.Товары.Обновить();
    КонецЕсли;
КонецПроцедуры
