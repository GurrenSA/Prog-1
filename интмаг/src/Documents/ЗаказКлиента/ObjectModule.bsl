Процедура ОбработкаПроведения(Отказ)
    Если ЭтотОбъект.Статус = Перечисления.СтатусыЗаказов.Подтвержден Тогда
        // Инициализация движений
        Движения.ОстаткиТоваров.Записывать = Истина;
        Движения.Продажи.Записывать = Истина;
        
        Для Каждого Строка Из Товары Цикл
            // Контроль остатков
            Отбор = Новый Структура();
            Отбор.Вставить("Номенклатура", Строка.Номенклатура);
            Отбор.Вставить("Склад", ЭтотОбъект.Склад);
            
            Остатки = РегистрыНакопления.ОстаткиТоваров.Остатки(ЭтотОбъект.Дата, Отбор);
            
            Если Остатки.Количество() = 0 Тогда
                Отказ = Истина;
                Сообщить("Недостаточно товара: " + Строка.Номенклатура);
                Возврат;
            КонецЕсли;
            
            Остаток = Остатки[0].Количество;
            
            Если Остаток < Строка.Количество Тогда
                Отказ = Истина;
                Сообщить("Недостаточно товара: " + Строка.Номенклатура + ". В наличии: " + Остаток);
                Возврат;
            КонецЕсли;
            
            // Создаем движение по регистру остатков (расход)
            Движение = Движения.ОстаткиТоваров.Добавить();
            Движение.Период = ЭтотОбъект.Дата;
            Движение.Номенклатура = Строка.Номенклатура;
            Движение.Склад = ЭтотОбъект.Склад;
            Движение.Количество = -Строка.Количество; // Указываем отрицательное значение для расхода
            
            // Создаем движение по регистру продаж (приход)
            ДвижениеП = Движения.Продажи.Добавить();
            ДвижениеП.Период = ЭтотОбъект.Дата;
            ДвижениеП.Номенклатура = Строка.Номенклатура;
            ДвижениеП.Клиент = ЭтотОбъект.Клиент;
            ДвижениеП.Склад = ЭтотОбъект.Склад;
            ДвижениеП.Количество = Строка.Количество;
            ДвижениеП.Сумма = Строка.Сумма;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры