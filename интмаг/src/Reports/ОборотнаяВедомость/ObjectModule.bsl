&НаСервере
Процедура КомпоновкаНаСервере(Источник, ДанныеОтчета)
    Настройки = Новый НастройкиКомпоновкиДанных;
    
    // Поля для отчета
    Поля = Настройки.Поля;
    Поля.Добавить("Период", "Период");
    Поля.Добавить("Номенклатура", "Номенклатура");
    Поля.Добавить("Приход", "Приход");
    Поля.Добавить("Расход", "Расход");
    Поля.Добавить("Остаток", "Остаток");
    
    // Источник данных - остатки товаров
    ИсточникДанных = Настройки.ИсточникиДанных.Добавить();
    ИсточникДанных.Источник = Новый ОписаниеИсточникаДанных("РегистрСведений.ОстаткиТоваров");
КонецПроцедуры
